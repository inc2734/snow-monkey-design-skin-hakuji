{
	"engines": {
		"node": ">=24.22.1",
		"npm": ">=11.18.0"
	},
	"volta": {
		"node": "24.22.1"
	},
	"author": "inc2734",
	"license": "GPL-2.0+",
	"dependencies": {
		"sass-basis": "^19.0.5"
	},
	"devDependencies": {
		"@wordpress/browserslist-config": "^7.0.0",
		"@wordpress/env": "^12.0.0",
		"autoprefixer": "^10.4.20",
		"cssnano": "^7.0.6",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.4.49",
		"postcss-cli": "^11.0.0",
		"rimraf": "^6.0.1",
		"sass": "^1.80.6"
	},
	"scripts": {
		"export:wp-content:themes": "npm run cli cp -- -r ../../themes .export/wp-content",
		"export:wp-content:uploads": "npm run cli cp -- -r ../../uploads .export/wp-content",
		"export:wp-content": "npm run cli rm -- -rf .export/wp-content && mkdir -p .export/wp-content/uploads && run-p export:wp-content:*",
		"export:db": "mkdir -p .export/sql && npm run wp db -- export .export/sql/local.sql",
		"export": "run-p export:*",
		"import:wp-content:themes": "npm run cli cp -- -r .export/wp-content/themes ../../",
		"import:wp-content:uploads": "npm run cli cp -- -r .export/wp-content/uploads ../../",
		"import:wp-content": "run-p import:wp-content:*",
		"import:db": "npm run wp db -- import .export/sql/local.sql",
		"import": "run-p import:*",
		"wp-env": "wp-env",
		"start": "wp-env start && open http://localhost:8888",
		"stop": "npm run export && wp-env stop",
		"destroy": "wp-env destroy && wp-env destroy --config=.wp-env.tests.json",
		"cli": "wp-env run cli --env-cwd=\"wp-content/plugins/snow-monkey-design-skin-hakuji\"",
		"wp": "wp-env run cli --env-cwd=\"wp-content/plugins/snow-monkey-design-skin-hakuji\" wp",
		"composer": "wp-env run --env-cwd=\"wp-content/plugins/snow-monkey-design-skin-hakuji\" cli composer",
		"test:php:start": "wp-env start --config=.wp-env.tests.json",
		"test:php:stop": "wp-env stop --config=.wp-env.tests.json",
		"test-composer": "wp-env run --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/snow-monkey-design-skin-hakuji\" cli composer",
		"pretest:php:lint": "npm run test:php:start && npm run test-composer install -- --no-interaction",
		"test:php:lint": "npm run test-composer lint",
		"posttest:php:lint": "npm run test:php:stop",
		"test:lint:php": "npm run test:php:lint || (status=$?; npm run test:php:stop; exit $status)",
		"test:lint": "run-s test:lint:*",
		"test": "run-s test:lint",
		"clean:zip": "rimraf snow-monkey-design-skin-hakuji.zip",
		"css:skin": "sass --no-source-map src/css/design-skin.scss:design-skin.css && postcss design-skin.css -r",
		"css:editor": "sass --no-source-map src/css/editor-style.scss:editor-style.css && postcss editor-style.css -r",
		"css:gutenberg": "sass --no-source-map src/css/gutenberg.scss:gutenberg.css && postcss gutenberg.css -r",
		"css": "npm-run-all -p css:*",
		"build": "npm run css",
		"zip:pack": "rsync -a --exclude='/vendor' --exclude='/node_modules' --exclude='.*' --exclude='*.config.js' --exclude='*.xml.dist' --exclude='*.ruleset.xml' --exclude='/bin' --exclude='/tests' --exclude='package*.json' . snow-monkey-design-skin-hakuji && wp-env start && npm run composer install -- --no-interaction --no-dev -d snow-monkey-design-skin-hakuji",
		"zip:archive": "zip -9 -qmr snow-monkey-design-skin-hakuji.zip snow-monkey-design-skin-hakuji",
		"zip": "npm run clean:zip && npm run zip:pack && npm run zip:archive"
	}
}
